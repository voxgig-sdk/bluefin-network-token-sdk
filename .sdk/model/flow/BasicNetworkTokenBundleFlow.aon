# BasicNetworkTokenBundleFlow

main: kit: flow: BasicNetworkTokenBundleFlow:
{
  entity: "network_token_bundle",
  kind: "basic",
  name: "BasicNetworkTokenBundleFlow",
  step: [
    {
      input: {
        ref: "network_token_bundle_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "network_token_bundle_ref01",
        srcdatavar: "network_token_bundle_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "network_token_bundle01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-network_token_bundle_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "network_token_bundle_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "network_token_bundle01"
      }

      op: "remove"
    }
  ],
  "key$": "BasicNetworkTokenBundleFlow"
}