-- BluefinNetworkToken SDK test runner (generated by @voxgig/sdkgen).
--
-- OFFLINE lane (always): a test-mode client seeded from the generated entity
-- test data answers operations from an in-memory store — no server needed.
-- LIVE lane (only when SDK_TEST_BASE is set): the same flow over real HTTP.

import VoxgigStruct
import SdkJson
import SdkRuntime
import SdkClient

open VoxgigStruct

initialize npass : IO.Ref Nat ← IO.mkRef 0
initialize nfail : IO.Ref Nat ← IO.mkRef 0

def pass (msg : String) : SIO Unit := do
  npass.modify (· + 1)
  IO.println s!"ok   - {msg}"

def fail (msg : String) : SIO Unit := do
  nfail.modify (· + 1)
  IO.println s!"FAIL - {msg}"

def defaultBase : String := "http://localhost:8901"

def main : IO UInt32 := do
  let liveBase ← IO.getEnv "SDK_TEST_BASE"
  let ctx ← mkCtx
  let offline : SIO Unit := do
    -- network_token_bundle: offline (test-mode) entity behaviour
    (do
      let seedPath := "../.sdk/test/entity/network_token_bundle/NetworkTokenBundleTestData.json"
      if !(← System.FilePath.pathExists seedPath) then
        IO.println s!"skip - network_token_bundle: no seed at {seedPath}"
      else do
        let seed ← SdkJson.jsonRead (← IO.FS.readFile seedPath)
        let tclient ← Sdk.testSdk0 seed
        let existing ← SdkRuntime.gp (← SdkRuntime.gp seed "existing") "network_token_bundle"
        let ids ← keysof existing
        -- load the first seeded entity by id
        if ids.size > 0 then do
          let wid := ids[0]!
          let m ← newMap #[("id", Value.str wid)]
          let got ← Network_token_bundle.load tclient m (← emptyMap)
          let gid ← SdkRuntime.gpS got "id"
          if gid == wid then pass s!"network_token_bundle.load offline (id={wid})"
          else fail s!"network_token_bundle.load offline: got {gid}, want {wid}"
        -- create -> load back -> remove, all in the store
        let newmap ← SdkRuntime.gp (← SdkRuntime.gp seed "new") "network_token_bundle"
        let nks ← keysof newmap
        if nks.size > 0 then do
          let payload ← SdkRuntime.gp newmap nks[0]!
          let created ← Network_token_bundle.create tclient payload (← emptyMap)
          let cid ← SdkRuntime.gpS created "id"
          if cid == "" then fail "network_token_bundle.create offline returned no id" else do
            let m2 ← newMap #[("id", Value.str cid)]
            let back ← Network_token_bundle.load tclient m2 (← emptyMap)
            if (← SdkRuntime.gpS back "id") == cid then
              pass s!"network_token_bundle.create/load offline (id={cid})"
            else fail s!"network_token_bundle.create/load offline mismatch"
            let _ ← Network_token_bundle.remove tclient m2 (← emptyMap)
            let gone ← Network_token_bundle.load tclient m2 (← emptyMap)
            match gone with
            | Value.map _ => fail s!"network_token_bundle.remove offline: still present"
            | _ => pass s!"network_token_bundle.remove offline (id={cid})"
)
  offline.run ctx
  match liveBase with
  | none => IO.println "skip - live lane (set SDK_TEST_BASE to enable)"
  | some base => do
    let live : SIO Unit := do
      let opts ← newMap #[("base", .str base)]
      let client ← Sdk.newSdk opts
      -- network_token_bundle: create / load / remove round-trip
      (do
        let d ← SdkJson.jsonRead "{}"
        let created ← Network_token_bundle.create client d (← emptyMap)
        let nid ← SdkRuntime.gpS created "id"
        if nid == "" then fail "network_token_bundle.create returned no id" else do
          let m ← newMap #[("id", .str nid)]
          let back ← Network_token_bundle.load client m (← emptyMap)
          let bid ← SdkRuntime.gpS back "id"
          if bid == nid then pass s!"network_token_bundle.create/load round-trip (id={nid})"
          else fail s!"network_token_bundle.load mismatch: {bid} != {nid}"
          let _ ← Network_token_bundle.remove client m (← emptyMap)
          pass s!"network_token_bundle.remove (id={nid})")
    live.run ctx
  let p ← npass.get
  let f ← nfail.get
  IO.println ""
  IO.println s!"PASS {p}  FAIL {f}"
  if f > 0 then return 1 else return 0
